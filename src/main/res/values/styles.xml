<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- FIX for M3 FloatingActionButton theme crash -->
    <style name="ThemeOverlay.Material3.FloatingActionButton.Primary" parent="">
        <item name="backgroundTint">#000000</item> <!-- atau @color/black -->
        <item name="rippleColor">#FFFFFF</item>     <!-- atau @color/white -->
    </style>

    <style name="Theme.Conversations3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
    </style>

    <style name="KeypadButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:textSize">20sp</item>
<!--        <item name="android:backgroundTint">@color/design_default_color_primary</item>-->
<!--        <item name="android:textColor">@android:color/white</item>-->
    </style>

    <style name="PinBoxStyle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/pin_box_bg</item>
    </style>

    <style name="KeypadButtonStyle">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@color/oren_seliso</item>
    </style>

</resources>