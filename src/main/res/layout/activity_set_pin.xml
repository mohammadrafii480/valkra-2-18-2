<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_grey_seliso">

    <!-- Background logo -->
    <ImageView
        android:src="@drawable/main_logo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true"
        android:scaleType="centerInside"
        android:alpha="0.1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur PIN Anda"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <!-- PIN Display Kotak -->
        <LinearLayout
            android:id="@+id/pin_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- 6 Kotak -->
            <View android:id="@+id/pin_box_1" style="@style/PinBoxStyle" />
            <View android:id="@+id/pin_box_2" style="@style/PinBoxStyle" />
            <View android:id="@+id/pin_box_3" style="@style/PinBoxStyle" />
            <View android:id="@+id/pin_box_4" style="@style/PinBoxStyle" />
            <View android:id="@+id/pin_box_5" style="@style/PinBoxStyle" />
            <View android:id="@+id/pin_box_6" style="@style/PinBoxStyle" />
        </LinearLayout>

        <!-- Numpad -->
        <GridLayout
            android:id="@+id/keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <Button android:text="1" style="@style/KeypadButtonStyle"/>
            <Button android:text="2" style="@style/KeypadButtonStyle"/>
            <Button android:text="3" style="@style/KeypadButtonStyle"/>
            <Button android:text="4" style="@style/KeypadButtonStyle"/>
            <Button android:text="5" style="@style/KeypadButtonStyle"/>
            <Button android:text="6" style="@style/KeypadButtonStyle"/>
            <Button android:text="7" style="@style/KeypadButtonStyle"/>
            <Button android:text="8" style="@style/KeypadButtonStyle"/>
            <Button android:text="9" style="@style/KeypadButtonStyle"/>
            <Button android:text="C" style="@style/KeypadButtonStyle"/>
            <Button android:text="0" style="@style/KeypadButtonStyle"/>
            <Button android:text="⌫" style="@style/KeypadButtonStyle"/>
        </GridLayout>

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/btn_save"
            android:text="Simpan PIN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/oren_seliso"
            android:textColor="@android:color/white"/>
    </LinearLayout>
</RelativeLayout>